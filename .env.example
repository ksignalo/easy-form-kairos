# Environment configuration — copy to .env and fill in real values
# DO NOT commit .env to source control

ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

API_BASE_URL=https://api.jewelleryhiring.com

GEMINI_API_KEY=your_gemini_api_key
GROK_API_KEY=your_grok_api_key
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Which AI provider to use for extraction: gemini | grok | ollama
AI_PROVIDER=gemini

# Timeout in milliseconds for AI provider calls
AI_TIMEOUT_MS=20000

# Maximum retries for auth and submission
MAX_RETRIES_AUTH=1
MAX_RETRIES_SUBMIT=2

# Set to true to enforce daily quota guard (tracks volume in memory per process run)
DAILY_QUOTA_GUARD_ENABLED=false
